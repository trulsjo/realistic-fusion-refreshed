#!/bin/sh
# Refuses a commit while a scripts/run-gates.ps1 run is live (#872), through gates-running.ps1
# beside this file, whose header says how a run is told from a stale marker. Then checks what the
# commit commits, as staged, and runs every check so one commit shows what each found:
#
# - the staged Markdown, by the shared markdown-check.ps1 (#658), and of the wrapped files staged,
#   each prose line against 100 characters and each figure grouped in thousands split across a
#   line end (#863), as staged: each is written out of the index into a folder under the git
#   directory, and the check reads it there with GIT_DIR and GIT_WORK_TREE pointing git at this
#   repository's index, so a link inside this repository is resolved as the first check resolves
#   it. A link into the submodule it reports as not checked, since the folder has no submodule;
#   the first Markdown check resolves those links;
# - the staged scripts, hooks and workflows, for a comment line over 100 characters, by the shared
#   comment-line-check.ps1 (#863), in the form its second example gives;
# - the staged *.ps1 directly under scripts/ and .githooks/ (#863), written out of the index into
#   the same folder: by param-check.ps1, a list parameter never split on commas; by
#   variable-case-check.ps1, a variable spelt two ways in one scope; by help-check.ps1, a help
#   block PowerShell does not read; and, on those that set strict mode, by strict-list-check.ps1,
#   a read strict mode can throw on. With none staged, it says it read none.
#
# The shared scripts are in vendor/grado-factorio-tools/scripts/. What each reads as what, and what
# it cannot see, is in its header; this is only the wiring. scripts/ship-check.ps1 runs the
# Markdown check over every tracked Markdown file, which is where a clone without this hook is held
# to it.
#
# INSTALL: the same two steps as commit-msg, which has them.
#
# A missing pwsh says nothing was checked and lets the commit through, and an uninitialised
# submodule says the shared checks did NOT run and lets it through, the posture commit-msg takes
# and for its reasons.
#
# Each refusal, the live run's included, ends with a line saying the message was not saved, since
# .git/COMMIT_EDITMSG still holds the last message git wrote there, not this one (#898). A commit
# let through gets no line.
#
# What the scripts' step cannot see: a script is taken as setting strict mode where a line of it
# begins with Set-StrictMode, after any indent. A path is listed with core.quotePath off; one git
# quotes even so, as one holding a double quote, a backslash or a line break, is not read by the
# scripts' step, and nothing says so. A path holding a comma is split by the checks.
if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-commit: pwsh not found, so neither a live run-gates.ps1 run nor the staged files were checked." >&2
    exit 0
fi

# Git runs this hook before it writes .git/COMMIT_EDITMSG, so after a refusal the file still holds
# the last message git wrote there: the previous commit's, or one a commit-msg hook rejected since.
# `git commit -F .git/COMMIT_EDITMSG`, which commit-msg's header gives for its own rejections,
# would commit under it (#898). Every refusal says so, whichever way out it takes; the trap below
# that removes the scratch folder says it too.
unsaved() {
    [ "$1" -eq 0 ] || echo "pre-commit: refused, and the message was not saved: .git/COMMIT_EDITMSG still holds an earlier one, the previous commit's or one commit-msg rejected, so give the message again." >&2
}
trap 'unsaved $?' EXIT

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1
pwsh -NoProfile -File "$root/.githooks/gates-running.ps1" -Root "$root" || exit 1

tools="$root/vendor/grado-factorio-tools/scripts"
if [ ! -f "$tools/markdown-check.ps1" ]; then
    echo "pre-commit: $tools/markdown-check.ps1 not found, so the staged Markdown and scripts were NOT checked." >&2
    echo "pre-commit: run 'git submodule update --init' to wire up the shared checks." >&2
    exit 0
fi

status=0
pwsh -NoProfile -File "$tools/markdown-check.ps1" || status=1

pwsh -NoProfile -File "$tools/comment-line-check.ps1" -Path 'scripts/*.ps1,.githooks/*,.github/workflows/*.yml' || status=1

# The wrapped files, as docs/agents/code-review.md names them, less the review skill: its front
# matter's description is one long line, which ship-check.ps1 section 12 leaves alone and the
# shared check does not (grado-factorio-tools#496).
wrapped='docs/agents/code-review.md docs/agents/review-figures.md docs/agents/code-review-history.md docs/agents/code-review-evidence.md docs/agents/plugin-pass.md CLAUDE.md scripts/CLAUDE.md'
staged_all="$(git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR)"
wide=""
for f in $wrapped; do
    if printf '%s\n' "$staged_all" | grep -qxF "$f"; then wide="${wide:+$wide
}$f"; fi
done
staged="$(printf '%s\n' "$staged_all" | grep -E '^(scripts|\.githooks)/[^/]*\.ps1$')"

if [ -z "$wide" ] && [ -z "$staged" ]; then
    echo "OK - pre-commit: no wrapped file and no *.ps1 directly under scripts/ or .githooks/ is staged, so the width check, the parameter, variable-case, help and strict-list checks read none."
    exit $status
fi

# Under the git directory, a path git and pwsh both read alike on every system. Removed on every
# way out, an interrupt included.
gitdir="$(git rev-parse --absolute-git-dir)"
scratch="$gitdir/pre-commit-staged-$$"
trap 's=$?; rm -rf "${scratch:?}"; unsaved $s' EXIT
trap 'exit 1' HUP INT TERM
both="$(printf '%s\n%s\n' "$wide" "$staged" | grep -v '^$')"
if ! printf '%s\n' "$both" | git checkout-index --stdin --prefix="$scratch/"; then
    echo "pre-commit: git checkout-index could not write the staged files out, so the width check and the scripts' checks did NOT run." >&2
    exit 1
fi
missing="$(printf '%s\n' "$both" | while IFS= read -r f; do
    [ -f "$scratch/$f" ] || printf '%s\n' "$f"
done)"
if [ -n "$missing" ]; then
    echo "pre-commit: these staged files could not be read as staged, so the width check and the scripts' checks did NOT run:" >&2
    printf '%s\n' "$missing" | sed 's/^/    /' >&2
    exit 1
fi

if [ -z "$wide" ]; then
    echo "OK - pre-commit: no wrapped file is staged, so the width check read none."
else
    # git commit hands a hook GIT_INDEX_FILE, often relative to the root; from the scratch folder
    # a relative one names no index, git lists no tracked file, and every link fails. So it is
    # made absolute first, and the repository's own index taken where none is set.
    index="${GIT_INDEX_FILE:-$gitdir/index}"
    case "$index" in
        /* | [A-Za-z]:*) ;;
        *) index="$root/$index" ;;
    esac
    (
        cd "$scratch" || exit 1
        GIT_DIR="$gitdir" GIT_WORK_TREE="$scratch" GIT_INDEX_FILE="$index" \
            pwsh -NoProfile -File "$tools/markdown-check.ps1" -Path "$(printf '%s\n' "$wide" | paste -sd, -)" -MaxLineLength 100
    ) || status=1
fi

if [ -z "$staged" ]; then
    echo "OK - pre-commit: no *.ps1 directly under scripts/ or .githooks/ is staged, so the parameter, variable-case, help and strict-list checks read none."
else
    list="$(printf '%s\n' "$staged" | paste -sd, -)"
    strict="$(printf '%s\n' "$staged" | while IFS= read -r f; do
        if grep -q '^[[:space:]]*Set-StrictMode' "$scratch/$f"; then printf '%s\n' "$f"; fi
    done | paste -sd, -)"
    # Run from the folder, so each script is named by its path from the root.
    (
        cd "$scratch" || exit 1
        s=0
        for d in scripts .githooks; do
            [ -d "$d" ] || continue
            ls "$d"/*.ps1 >/dev/null 2>&1 || continue
            pwsh -NoProfile -File "$tools/param-check.ps1" "$d" || s=1
            pwsh -NoProfile -File "$tools/variable-case-check.ps1" "$d" || s=1
        done
        pwsh -NoProfile -File "$tools/help-check.ps1" "$list" || s=1
        if [ -z "$strict" ]; then
            echo "OK - strict-list check: none of the staged scripts sets strict mode, so none was read."
        else
            pwsh -NoProfile -File "$tools/strict-list-check.ps1" "$strict" || s=1
        fi
        exit $s
    ) || status=1
fi
exit $status
