# Personal, machine-local agent notes — see CLAUDE.md
CLAUDE.local.md

# Generated knowledge-graph output; rebuildable from the repo contents
graphify-out/

# Agent orchestration state — session-scoped, machine-local
.omc/

# Claude Code's own local state — config and a scheduler lock file, neither of which
# describes this project. If a project-scoped setting is ever worth sharing, negate it
# here rather than dropping this rule.
.claude/

# Built mod zips — reproducible from the working tree with scripts/pack-mods.ps1
dist/

# Third-party mods fetched by scripts/fetch-mods.ps1 at pinned versions. Reproducible, and
# large -- Krastorio 2 alone is 30 MB. Never this repo's own code.
.mod-cache*/

# Rendered tech-tree viewers -- rebuildable from any mod set with scripts/tree-viewer.ps1
tree-viewer-out/
# Bytecode Blender's bundled Python writes beside docs/research/*/ scripts it runs
__pycache__/

# The raw --dump-data tools/extract-geometry.py takes when not handed one; 14 MB, rebuildable
.dump/

# Blender's save-over backups beside models/<machine>/<machine>.blend; the model is the .blend
*.blend1
